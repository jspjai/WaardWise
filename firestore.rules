rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAssignedToWard(wardId) {
      return wardId in get(/databases/$(database)/documents/surveyors/$(request.auth.uid)).data.assignedWardIds;
    }

    // --- Collection Rules ---

    match /roles_admin/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      // Allow specific super admin to bootstrap themselves, or existing admins to create others
      allow create: if isSignedIn() && (
        (request.auth.uid == userId && request.auth.token.email == 'suryajai642@gmail.com') || 
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    match /wards/{wardId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();

      match /booths/{boothId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isAdmin();
      }
    }

    match /surveyors/{surveyorId} {
      allow get: if isAdmin() || isOwner(surveyorId);
      allow list: if isAdmin();
      allow create: if isOwner(surveyorId) && request.resource.data.id == surveyorId;
      allow update: if (isAdmin() || isOwner(surveyorId)) && resource != null && request.resource.data.id == resource.data.id;
      allow delete: if isAdmin() && resource != null;
    }

    match /candidates/{candidateId} {
      allow get: if isAdmin() || isOwner(candidateId);
      allow list: if isAdmin();
      allow create: if isOwner(candidateId) && request.resource.data.id == candidateId;
      allow update: if (isAdmin() || isOwner(candidateId)) && resource != null && request.resource.data.id == resource.data.id;
      allow delete: if isAdmin() && resource != null;
    }

    match /surveys/{surveyId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.surveyorId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && request.query.limit <= 100);

      allow create: if isSignedIn() 
                    && request.resource.data.surveyorId == request.auth.uid
                    && isAssignedToWard(request.resource.data.wardId);
      
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }
  }
}