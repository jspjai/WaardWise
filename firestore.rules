
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && 
        (getUserData().role == 'ADMIN' || request.auth.token.email == 'suryajai642@gmail.com');
    }

    function isSurveyor() {
      return isSignedIn() && getUserData().role == 'SURVEYOR';
    }

    function isViewer() {
      return isSignedIn() && getUserData().role == 'VIEWER';
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin() || (request.auth.token.email == 'suryajai642@gmail.com' && request.auth.uid == userId);
    }

    // --- Surveys Collection ---
    match /surveys/{surveyId} {
      allow read: if isAdmin() || 
                  (isSurveyor() && resource.data.createdBy == request.auth.uid) ||
                  (isViewer() && exists(/databases/$(database)/documents/survey_access/$(request.auth.uid + '_' + surveyId)));
      allow create: if isAdmin() || isSurveyor();
      allow update, delete: if isAdmin() || (isSurveyor() && resource.data.createdBy == request.auth.uid);
    }

    // --- Viewer Requests ---
    match /viewer_requests/{requestId} {
      allow create: if true; // Public access
      allow read, write: if isAdmin();
    }

    // --- Survey Access Mapping ---
    match /survey_access/{accessId} {
      allow read, write: if isAdmin();
    }
  }
}
