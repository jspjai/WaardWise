rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * TRS Group | Ward Intelligence Portal Security Rules
     * 
     * Implementations:
     * - Role-Based Access Control (RBAC) via dedicated collections.
     * - Initialization path for the Super Admin (suryajai642@gmail.com).
     * - Ownership-based access for field surveyors.
     * - Assignment-based access for candidates (unlocked wards).
     */

    // --- Global Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdminEmail() {
      return isSignedIn() && request.auth.token.email == 'suryajai642@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/roles_admin/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // --- Collection Rules ---

    // Admins Collection
    match /roles_admin/{userId} {
      // Users can always check their own admin status
      allow get: if isOwner(userId);
      // Only the super admin email can create the first admin doc for themselves
      allow create: if isSuperAdminEmail() && isOwner(userId);
      // Admins can manage all admin records
      allow read, write: if isAdmin();
    }

    // Surveyors Collection
    match /surveyors/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Candidates Collection
    match /candidates/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Wards Collection
    match /wards/{wardId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Surveys Collection
    match /surveys/{surveyId} {
      // Surveyors can read/write their own; Admins can do everything
      allow get: if isSignedIn() && (resource.data.surveyorId == request.auth.uid || isAdmin());
      allow list: if isSignedIn(); // Queries are expected to be filtered by surveyorId or wardId
      allow create: if isSignedIn(); // Validation of surveyorId field happens in application
      allow update: if isAdmin() || (resource.data.surveyorId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Settings Collection
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
