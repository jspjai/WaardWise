rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'suryajai642@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }

    function isSurveyor() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SURVEYOR';
    }

    function isViewer() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'VIEWER';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin() || request.auth.token.email == 'suryajai642@gmail.com';
    }

    match /surveys/{surveyId} {
      allow read: if isAdmin() || 
                  (isSurveyor() && resource.data.surveyorId == request.auth.uid) ||
                  (isViewer() && exists(/databases/$(database)/documents/survey_access/$(request.auth.uid + '_' + surveyId)));
      allow create: if isAdmin() || isSurveyor();
      allow update, delete: if isAdmin() || (isSurveyor() && resource.data.surveyorId == request.auth.uid);
    }

    match /viewer_requests/{requestId} {
      allow create: if true; 
      allow read, write: if isAdmin();
    }

    match /survey_access/{accessId} {
      // Allow viewers to read their own mappings
      allow read: if isAdmin() || (isSignedIn() && (resource.data.viewerId == request.auth.uid || accessId.startsWith(request.auth.uid)));
      allow write: if isAdmin();
    }

    match /support_tickets/{ticketId} {
      // Allow any signed-in user to create a ticket
      allow create: if isSignedIn();
      // Allow Admins to see all, or viewers to see their own. Handle null resource for creation check.
      allow read, write: if isAdmin() || (isSignedIn() && (resource == null || resource.data.viewerId == request.auth.uid));
    }

    match /wards/{wardId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
