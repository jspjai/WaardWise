
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Safer admin check that handles missing user documents gracefully
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'suryajai642@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }

    function isSurveyor() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SURVEYOR';
    }

    function isViewer() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'VIEWER';
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Super admin can always write to initialize the system
      allow write: if isAdmin() || request.auth.token.email == 'suryajai642@gmail.com';
    }

    // --- Surveys Collection ---
    match /surveys/{surveyId} {
      allow read: if isAdmin() || 
                  (isSurveyor() && resource.data.surveyorId == request.auth.uid) ||
                  (isViewer() && exists(/databases/$(database)/documents/survey_access/$(request.auth.uid + '_' + surveyId)));
      allow create: if isAdmin() || isSurveyor();
      allow update, delete: if isAdmin() || (isSurveyor() && resource.data.surveyorId == request.auth.uid);
    }

    // --- Viewer Requests ---
    match /viewer_requests/{requestId} {
      allow create: if true; // Public access for the request form
      allow read, write: if isAdmin();
    }

    // --- Survey Access Mapping ---
    match /survey_access/{accessId} {
      allow read, write: if isAdmin();
    }

    // --- Roles Collections ---
    match /roles_admin/{adminId} {
      allow read, write: if isAdmin();
    }
    
    match /surveyors/{surveyorId} {
      allow read, write: if isAdmin();
    }

    match /candidates/{candidateId} {
      allow read, write: if isAdmin();
    }

    // --- Wards Collection ---
    match /wards/{wardId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Settings Collection ---
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
