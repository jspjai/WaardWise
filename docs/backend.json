{
  "entities": {
    "AdminProfile": {
      "title": "AdminProfile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["ADMIN"] }
      },
      "required": ["id", "email", "role"]
    },
    "SurveyorProfile": {
      "title": "SurveyorProfile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "assignedWardIds": { "type": "array", "items": { "type": "string" } },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name", "email", "isActive"]
    },
    "CandidateProfile": {
      "title": "CandidateProfile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "purchasedWardIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "email"]
    },
    "Ward": {
      "title": "Ward",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "district": { "type": "string" },
        "surveyCount": { "type": "number" },
        "price": { "type": "number" },
        "isAvailableForPurchase": { "type": "boolean" }
      },
      "required": ["id", "name", "district"]
    },
    "Survey": {
      "title": "Survey",
      "type": "object",
      "properties": {
        "wardId": { "type": "string" },
        "boothNumber": { "type": "string" },
        "surveyorId": { "type": "string" },
        "respondentName": { "type": "string" },
        "householdVoterMood": { "type": "string", "enum": ["Pro-change", "Neutral", "Pro-continuity"] },
        "topIssue": { "type": "string" },
        "notes": { "type": "string" },
        "submissionTimestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["wardId", "surveyorId", "submissionTimestamp"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/roles_admin/{userId}": {
      "schema": "AdminProfile",
      "description": "Administrative users with full platform access."
    },
    "/surveyors/{userId}": {
      "schema": "SurveyorProfile",
      "description": "Field surveyors collecting ward-level data."
    },
    "/candidates/{userId}": {
      "schema": "CandidateProfile",
      "description": "Political candidates accessing purchased ward intelligence."
    },
    "/wards/{wardId}": {
      "schema": "Ward",
      "description": "Ward-level geographic and pricing information."
    },
    "/surveys/{surveyId}": {
      "schema": "Survey",
      "description": "Collected survey data points from field operations."
    },
    "/settings/{docId}": {
      "schema": "object",
      "description": "Global platform configuration settings."
    }
  }
}
